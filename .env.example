# ================================================================
# RESEND EMAIL CONFIGURATION
# ================================================================
# 1. Sign up for free at https://resend.com
# 2. Generate an API Key under API Keys tab: https://resend.com/api-keys
# 3. Create a local '.env' file in this folder and paste your key below:

RESEND_API_KEY=re_your_api_key_here

# Recipient Email (Where portfolio contact submissions will be sent)
RESEND_TO_EMAIL=shafeekrahman04@gmail.com

# From Email Address:
# - Default for Resend free testing: "onboarding@resend.dev"
# - Once you verify your domain in Resend: "Shafeek Rahman <contact@yourdomain.com>"
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
